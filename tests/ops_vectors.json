[
  { "name": "set creates parent objects",
    "ops": [ { "op": "set", "path": ["control", "TPB"], "value": { "lat": 39.5, "lon": -105.3, "use": true } } ],
    "expect": { "rev": 1, "control": { "TPB": { "lat": 39.5, "lon": -105.3, "use": true } } } },

  { "name": "nested set and delete",
    "ops": [ { "op": "set", "path": ["settings", "hold"], "value": false },
             { "op": "set", "path": ["control", "W16"], "value": { "lat": 1, "lon": 2 } },
             { "op": "del", "path": ["control", "W16"] } ],
    "expect": { "rev": 3, "control": {}, "settings": { "hold": false } } },

  { "name": "push, patch, remove by id",
    "ops": [ { "op": "push", "path": ["savedPoints"], "value": { "id": "a", "note": "gate" } },
             { "op": "push", "path": ["savedPoints"], "value": { "id": "b", "note": "rock" } },
             { "op": "patch", "path": ["savedPoints"], "id": "a", "value": { "note": "north gate" } },
             { "op": "remove", "path": ["savedPoints"], "id": "b" } ],
    "expect": { "rev": 4, "savedPoints": [ { "id": "a", "note": "north gate" } ] } },

  { "name": "set rough placement wholesale",
    "ops": [ { "op": "set", "path": ["rough"], "value": { "A": 1, "B": 0, "tx": 5, "ty": 6, "origin": { "lat": 39.5, "lon": -105.3, "h": 2640 } } } ],
    "expect": { "rev": 1, "rough": { "A": 1, "B": 0, "tx": 5, "ty": 6, "origin": { "lat": 39.5, "lon": -105.3, "h": 2640 } } } },

  { "name": "reject unknown top-level key", "ops": [ { "op": "set", "path": ["evil"], "value": 1 } ], "error": true },
  { "name": "reject __proto__ key", "ops": [ { "op": "set", "path": ["control", "__proto__"], "value": { "x": 1 } } ], "error": true },
  { "name": "reject constructor key", "ops": [ { "op": "set", "path": ["settings", "constructor"], "value": 1 } ], "error": true },
  { "name": "reject empty path", "ops": [ { "op": "set", "path": [], "value": 1 } ], "error": true },
  { "name": "reject unknown op", "ops": [ { "op": "nuke", "path": ["control"] } ], "error": true },
  { "name": "reject duplicate id",
    "ops": [ { "op": "push", "path": ["savedPoints"], "value": { "id": "a" } },
             { "op": "push", "path": ["savedPoints"], "value": { "id": "a" } } ], "error": true },
  { "name": "reject push without id", "ops": [ { "op": "push", "path": ["savedPoints"], "value": { "note": "x" } } ], "error": true },
  { "name": "reject remove of missing id", "ops": [ { "op": "remove", "path": ["savedPoints"], "id": "zz" } ], "error": true },
  { "name": "reject patch that changes id",
    "ops": [ { "op": "push", "path": ["savedPoints"], "value": { "id": "a" } },
             { "op": "patch", "path": ["savedPoints"], "id": "a", "value": { "id": "b" } } ], "error": true },
  { "name": "reject delete of missing key", "ops": [ { "op": "del", "path": ["control", "NOPE"] } ], "error": true },
  { "name": "reject push to non-array", "ops": [ { "op": "push", "path": ["control"], "value": { "id": "a" } } ], "error": true },
  { "name": "reject an array inside the path (edit list items by id instead)",
    "ops": [ { "op": "push", "path": ["savedPoints"], "value": { "id": "a" } },
             { "op": "set", "path": ["savedPoints", "0", "note"], "value": "x" } ], "error": true },
  { "name": "reject remove without an id",
    "ops": [ { "op": "push", "path": ["savedPoints"], "value": { "note": "no id", "id": "a" } },
             { "op": "remove", "path": ["savedPoints"] } ], "error": true },
  { "name": "set replaces a non-object parent",
    "ops": [ { "op": "set", "path": ["settings", "units"], "value": "m" },
             { "op": "set", "path": ["settings", "units", "x"], "value": 1 } ],
    "expect": { "rev": 2, "settings": { "units": { "x": 1 } } } }
]
